# =============================================================================
# ERPAdv — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env nem arquivos de service account.
# =============================================================================

# ---------------------------------------------------------------- Firebase (público / web)
# Para desenvolvimento com o Emulator Suite, mantenha o projeto "demo-erpadv".
FIREBASE_PROJECT_ID=demo-erpadv
FIREBASE_WEB_API_KEY=demo-api-key
FIREBASE_AUTH_DOMAIN=demo-erpadv.firebaseapp.com
FIREBASE_STORAGE_BUCKET=demo-erpadv.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:0000000000000000
# Chave pública Web Push (Cloud Messaging → Certificados push da Web). Vazia = push desativado.
FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------- Backend
# Chaves de criptografia de dados pessoais (LGPD). Gere chaves próprias para produção:
#   openssl rand -base64 32     (DATA_ENCRYPTION_KEY — exatamente 32 bytes)
#   openssl rand -base64 48     (SEARCH_HMAC_KEY — 32 bytes ou mais)
# Os valores abaixo são de DESENVOLVIMENTO e são recusados quando APP_PRODUCTION=true.
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=
SEARCH_HMAC_KEY=ZGV2LW9ubHktaG1hYy1rZXktY2hhbmdlLW1lLTMyYnl0ZXM=
# Exigir e-mail verificado antes de criar o escritório (recomendado: true em produção)
REQUIRE_EMAIL_VERIFIED=false
RATE_LIMIT_PER_MINUTE=300
# Jobs de alertas de prazos e lembretes de agenda (deixe true em apenas uma réplica, ou em todas: há trava distribuída)
JOBS_ENABLED=true
# Painel master da plataforma (desenvolvedor): e-mails separados por vírgula. Quem entrar com um
# desses e-mails (verificado, quando REQUIRE_EMAIL_VERIFIED=true) cria escritórios e administradores.
PLATFORM_MASTER_EMAILS=
# Comercialização (Fase 6): avaliação gratuita dos novos escritórios e horário da cobrança diária das assinaturas.
# A cobrança é manual: o master define preços em Plataforma → Planos e dá baixa nas faturas pagas.
BILLING_TRIAL_PLAN=ENTERPRISE
BILLING_TRIAL_DAYS=14
BILLING_CRON=0 0 6 * * *
# Limite por arquivo da central de documentos, em MB (máx. 200). Acima de 28 MB, aumente também
# client_max_body_size em docker/nginx/default.conf.template (hoje 30m).
DOCUMENTS_MAX_MB=25
# ---------------------------------------------------------------- integrações (Fase 4)
# DataJud (CNJ): chave pública divulgada em https://datajud-wiki.cnj.jus.br/api-publica/acesso — copie a atual.
DATAJUD_API_KEY=
# IA jurídica (Claude, da Anthropic): chave em https://console.anthropic.com — fica só no backend. Depois de configurar,
# o administrador ainda precisa ATIVAR o conector "IA jurídica" em Integrações (decisão do escritório sobre sigilo/LGPD).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Fallback do provedor quando o modelo recusa por política de segurança: default | off
AI_FALLBACKS=default
# Google Agenda/Meet: crie um cliente OAuth "Aplicativo da Web" no Google Cloud Console, com o redirecionamento
# https://SEU_DOMINIO/api/hooks/google/callback e a API Google Calendar ativada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# E-mail: SMTP do ambiente (no Docker de desenvolvimento usa o Mailpit). Cada escritório pode ter o próprio SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Origem pública do frontend (CORS)
CORS_ALLOWED_ORIGINS=https://localhost:8443

# ---------------------------------------------------------------- Portas (desenvolvimento)
HTTP_PORT=8000
HTTPS_PORT=8443
EMULATOR_UI_PORT=4000
EMULATOR_AUTH_PORT=9099
EMULATOR_FIRESTORE_PORT=8080
EMULATOR_STORAGE_PORT=9199
